# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Email Delivery for /api/contact (configure ONE of the options below in Vercel / Environment Variables):
# Option 1 (Direct Gmail SMTP - recommended for gmchedlishvilikhmaladze@gmail.com):
# Create a Google App Password at https://myaccount.google.com/apppasswords
GMAIL_USER="gmchedlishvilikhmaladze@gmail.com"
GMAIL_APP_PASSWORD=""

# Option 2 (Resend API):
RESEND_API_KEY=""

# Option 3 (Web3Forms API - free access key from https://web3forms.com):
WEB3FORMS_ACCESS_KEY=""
